# Server-only settings. Do not rename these to VITE_*.
RESEND_API_KEY=
# Use an address on a verified Resend domain, e.g. Campus+ <events@yourdomain.com>
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Choose either a Twilio sender number (E.164) or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Blank permits localhost/127.0.0.1 origins in development.
# For deployment set the exact public origin, e.g. https://campus.example.com
APP_ORIGIN=
PORT=3000
HOST=127.0.0.1
MAX_REGISTRATIONS_PER_DAY=100
